# ==============================================================================
# MyAsset Environment Configuration Template (.env.example)
# Copy this file to .env for local development.
# In Vercel, configure these under: Project Settings > Environment Variables.
# NEVER commit your real .env file or production secrets to Git.
# ==============================================================================

# Application Environment ('development' locally, 'production' on Vercel)
NODE_ENV=development

# Server Port (used for local development; Vercel assigns its own port)
PORT=3000

# Authentication & Session Security (CRITICAL)
# Set to a strong, high-entropy 64+ character random string in production.
# Example generation: openssl rand -base64 48
COOKIE_SECRET=change_this_to_a_secure_random_secret_in_production

# CORS Allowed Origin
# In production on Vercel, leave blank to allow the Vercel app domain,
# or specify your production custom domain (e.g., https://myasset.example.com).
ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------

# Local SQLite Database Path (used for local development and test suite)
DB_PATH=./server/db/myasset.sqlite

# Production Managed PostgreSQL Connection URL (for Vercel deployment)
# Provided automatically if using Vercel Postgres / Neon integration:
# e.g., postgres://default:xxxx@ep-cool-dawn-123456.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require
DATABASE_URL=postgres://user:password@hostname:5432/myasset_db?sslmode=require
POSTGRES_URL=postgres://user:password@hostname:5432/myasset_db?sslmode=require
